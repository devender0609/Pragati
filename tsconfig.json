{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  // v0.70 — `tools` is included so the unit suite can assert against the
  // SAME route contracts the screenshot harness enforces. If the tests
  // used their own copy, one could pass while the harness applied
  // different rules, and the guard would quietly stop guarding.
  "include": ["src", "tools"],
  "exclude": ["node_modules", "dist"]
}
